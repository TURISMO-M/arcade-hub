rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 50
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 30
        && data.username.matches('^[a-zA-Z0-9_.\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation blueprint: ScoreEntry
    function isValidScoreEntry(data) {
      return data.keys().hasAll(['uid', 'name', 'score', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'score', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 50
        && data.score is int
        && data.score >= 0
        && data.score <= 1000000
        && data.updatedAt is timestamp;
    }

    // Private player profile documents
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);
    }

    // Global leaderboard score entries (no PII; public top-score read, owner-only write)
    match /scores/{userId} {
      allow get: if isValidId(userId)
        && (isOwner(userId) || (resource != null && existing().score is int && existing().score >= 0));

      allow list: if existing().score is int
        && existing().score >= 0;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidScoreEntry(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidScoreEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().score >= existing().score
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'score', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId);
    }
  }
}
